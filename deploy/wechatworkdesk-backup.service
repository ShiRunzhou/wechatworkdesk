[Unit]
Description=WeChatWorkDesk canonical backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# SQLite reads the database in mode=ro, but needs access to its WAL shared-memory file.
ExecStart=/usr/bin/docker run --rm --network none --read-only --tmpfs /tmp:rw,noexec,nosuid,size=256m --cap-drop ALL --security-opt no-new-privileges -v /var/lib/wechatworkdesk:/var/lib/wechatworkdesk -v /var/backups/wechatworkdesk:/backups wechatworkdesk:prepared python tools/backup_cloud.py --data /var/lib/wechatworkdesk --output /backups
