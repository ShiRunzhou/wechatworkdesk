# Prepare only. Enable after trusted IP certificate and login configuration exist.
server {
    listen 80;
    server_name 42.193.174.4;
    location /.well-known/acme-challenge/ { root /var/lib/wechatworkdesk-acme; }
    location / { return 301 https://42.193.174.4$request_uri; }
}
server {
    listen 443 ssl;
    server_name 42.193.174.4;
    ssl_certificate /etc/wechatworkdesk/tls/fullchain.pem;
    ssl_certificate_key /etc/wechatworkdesk/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 200m;
    client_body_timeout 120s;
    location / {
        proxy_pass http://127.0.0.1:8770;
        proxy_set_header Host 127.0.0.1:8770;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Origin $http_origin;
        proxy_read_timeout 180s;
        proxy_request_buffering on;
        add_header X-Content-Type-Options nosniff always;
    }
}
